{
  "name": "@testwitness/extension-standard",
  "version": "0.1.1",
  "description": "Privacy-first TestWitness evidence capture extension for Chrome and Microsoft Edge.",
  "private": true,
  "author": "Shashikant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shashibeit/testwitness-extension.git"
  },
  "bugs": {
    "url": "https://github.com/shashibeit/testwitness-extension/issues"
  },
  "homepage": "https://github.com/shashibeit/testwitness-extension#readme",
  "keywords": [
    "qa",
    "testing",
    "evidence",
    "chrome-extension",
    "edge-extension",
    "testwitness"
  ],
  "type": "module",
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "node scripts/build.mjs && node scripts/validate-dist.mjs",
    "package": "npm run build && node scripts/package-extension.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests scripts vite.config.ts vitest.config.ts eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run test && npm run typecheck && npm run lint && npm run format:check && npm run build"
  },
  "dependencies": {
    "@testwitness/core": "file:../testwitness"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.1.35",
    "@types/node": "^24.10.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.4",
    "globals": "^17.12.0",
    "jsdom": "^27.4.0",
    "jszip": "^3.10.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT"
}
