{
  "manifest_version": 3,
  "name": "TestWitness Extension Standard",
  "short_name": "TestWitness",
  "version": "0.1.1",
  "description": "Every test has a story. Capture the proof.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "downloads",
    "offscreen",
    "scripting",
    "sidePanel",
    "storage",
    "tabCapture"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/testwitness-16.png",
    "32": "icons/testwitness-32.png",
    "48": "icons/testwitness-48.png",
    "128": "icons/testwitness-128.png"
  },
  "action": {
    "default_title": "Open TestWitness",
    "default_popup": "launcher.html",
    "default_icon": {
      "16": "icons/testwitness-16.png",
      "32": "icons/testwitness-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
